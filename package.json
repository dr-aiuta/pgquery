{
	"name": "pg-lightquery",
	"version": "0.5.1",
	"description": "postgres module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./schema": {
			"types": "./dist/schema/index.d.ts",
			"default": "./dist/schema/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"prepublishOnly": "npm run build",
		"start": "ts-node -r tsconfig-paths/register src/index.ts",
		"test": "jest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"dev": "ts-node -r tsconfig-paths/register src/index.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dr-aiuta/pgquery.git"
	},
	"keywords": [
		"postgresql",
		"sql"
	],
	"author": "danide r",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/dr-aiuta/pgquery/issues"
	},
	"homepage": "https://github.com/dr-aiuta/pgquery#readme",
	"devDependencies": {
		"@types/jest": "^29.4.0",
		"@types/node": "^20.17.16",
		"@types/pg": "^8.6.6",
		"@types/uuid": "^10.0.0",
		"jest": "^29.7.0",
		"prettier": "^3.9.9",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.7.3"
	},
	"dependencies": {
		"pg": "^8.10.0",
		"uuid": "^11.0.5"
	}
}
